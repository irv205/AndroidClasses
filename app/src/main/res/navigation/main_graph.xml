<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/blankFragment">

    <fragment
        android:id="@+id/blankFragment"
        android:name="com.irv205.testproject.presentation.login.BlankFragment"
        android:label="fragment_blank"
        tools:layout="@layout/fragment_blank" >
        <action
            android:id="@+id/action_blankFragment_to_secondFragment"
            app:destination="@id/secondFragment">
           <!-- <argument
                android:name="user_name"
                app:argType="string"
                android:defaultValue="No name"
                />-->
            <argument
                android:name="song"
                app:argType="com.irv205.testproject.domain.model.Song"
                />
        </action>
    </fragment>
    <fragment
        android:id="@+id/secondFragment"
        android:name="com.irv205.testproject.presentation.home.SecondFragment"
        android:label="SecondFragment"
        tools:layout="@layout/fragment_second"
        />
</navigation>